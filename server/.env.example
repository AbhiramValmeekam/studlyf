# Copy to .env and adjust. Every variable is optional in development.
# In production the server refuses to boot without MONGODB_URI, CORS_ORIGINS, APP_URL,
# MAIL_DRIVER=smtp and an explicit TRUST_PROXY (see README → Production notes).

NODE_ENV=development
PORT=4000
# LOG_LEVEL=debug                 # fatal|error|warn|info|debug|trace|silent
# TRUST_PROXY=1                   # number of proxy hops (set behind a load balancer/CDN so rate limits see real IPs)

# --- Database ---------------------------------------------------------------
# mongodb://user:pass@host:27017/studlyf     → self-hosted MongoDB (production)
# mongodb+srv://user:pass@cluster.mongodb.net → MongoDB Atlas (production)
# embedded:./.data/mongo                      → embedded mongod persisting to disk (default in dev)
# embedded:memory                             → throwaway embedded mongod (default in tests)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB_NAME=studlyf                     # overrides the database named in the URI

# --- URLs -------------------------------------------------------------------
# APP_URL is the site the browser actually visits. In the standard one-origin deployment this
# server serves that site itself, so it is this server's own public origin (plus CLIENT_DIR).
APP_URL=http://localhost:5173               # frontend; used in email links + reset redirects
API_PUBLIC_URL=http://localhost:4000        # this API's public origin
CORS_ORIGINS=http://localhost:5173          # comma-separated allow-list (credentials enabled)

# --- Static client (one-origin deployment) ---------------------------------------
# Directory holding the built frontend. When it contains an index.html this server serves it,
# with a SPA fallback for deep links, so the cookie is first-party and CORS is not involved
# at all. Point it at the Vite build output; leave it alone if a CDN serves the frontend.
# CLIENT_DIR=../dist

# --- Sessions / auth -----------------------------------------------------------
# COOKIE_NAME=studlyf_session
# COOKIE_SAMESITE=lax                     # lax (default) | strict | none. Use none ONLY when the
#                                         #   frontend is on a different site than this API —
#                                         #   none forces Secure, so it needs HTTPS.
# COOKIE_DOMAIN=.studlyf.com              # share the cookie between www. and api.
# COOKIE_SECURE=true                      # defaults to true in production
# SESSION_TTL_DAYS=30
# EMAIL_VERIFICATION_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_HASH_COST=15                   # scrypt N = 2^cost

# --- Email ---------------------------------------------------------------------
# MAIL_DRIVER=console                     # console (dev: prints links) | smtp | none | memory (tests)
#                                         #   In production this must be smtp (with SMTP_URL) or the
#                                         #   explicit `none` — the server refuses to boot on the other
#                                         #   two, because the console driver writes live verification
#                                         #   and password-reset links into the log stream and delivers
#                                         #   nothing. `none` accepts that mail is off: registration and
#                                         #   sign-in still work, but password reset does not.
# MAIL_FROM="STUDLYF <no-reply@studlyf.com>"
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# --- Media -----------------------------------------------------------------------
# STORAGE_DRIVER=local                    # only `local` exists; S3/R2 is not implemented
# UPLOAD_DIR=./uploads                    # MUST be a persistent volume in production —
#                                         #   nothing else stores uploads, and an ephemeral
#                                         #   filesystem loses every image on redeploy
# MEDIA_PUBLIC_BASE_URL=http://localhost:4000/media
# MAX_UPLOAD_MB=5

# --- Performance / protection ------------------------------------------------------
# RATE_LIMIT_ENABLED=true
# PUBLIC_CACHE_TTL_SECONDS=60             # server cache + Cache-Control max-age for public reads
