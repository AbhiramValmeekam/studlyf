{
  "name": "studlyf-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STUDLYF public website backend (Phase 1)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/database/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/database/seed.js",
    "db:seed:demo": "node --env-file-if-exists=.env src/database/seed-demo.js",
    "db:reset": "node --env-file-if-exists=.env src/database/seed.js --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:create": "node --env-file-if-exists=.env src/database/create-admin.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^5.0.1"
  }
}
